[Unit]
Description=Zabbix Agent 2 8.0 (compilado desde fuente)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zabbix
Group=zabbix
RuntimeDirectory=zabbix-agent2
RuntimeDirectoryMode=0755
LogsDirectory=zabbix
ExecStart=/usr/local/sbin/zabbix_agent2 -f -c /etc/zabbix/zabbix_agent2.conf
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
